{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["app.ts", "src/**/*.ts", "routes/**/*.ts", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist", "test", "scripts", "uploads", "data"]
}
