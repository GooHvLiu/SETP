# ============================================================
# 环境变量示例文件（.env.example）
# 用法：复制本文件为 .env，按需修改后生效
# 注意：.env 不提交 git，本文件是模板说明
# ============================================================

# -------------------- 应用配置 --------------------
# 运行环境：development / production
NODE_ENV=development
# 服务监听端口
APP_PORT=3000
# 监听地址，0.0.0.0 允许局域网访问
APP_HOST=0.0.0.0
# 本机局域网 IP（npm run init 自动检测写入，留空即可；用于启动时展示局域网访问地址）
LOCAL_IP=

# -------------------- 数据库配置 --------------------
# 数据库模式：mysql / sqlite（二态）
#   模板默认 MySQL（开箱即用的企业部署形态）
#   sqlite - 文件库，零配置快速体验；不改代码，只切本段
#   mysql  - MySQL 8.0+ / MariaDB 10.6+，需先建库
# 切库只改本段：DB_TYPE 与 DATABASE_URL 同时改，CLI 自动选择
# prisma/schema.mysql.prisma 与 prisma/migrations/mysql，不需要手改 provider
DB_TYPE=mysql
# Prisma 连接串（与 DB_TYPE 对应）：
#   mysql 模式：mysql://user:password@127.0.0.1:3306/db_name
#   sqlite 模式：file:./data/app.db
#   密码含特殊字符时做 URL 编码，例如 @ 写成 %40
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/setp"
# MySQL 连接池上限（SQLite 忽略）
DB_POOL_SIZE=10
# Docker Compose 暴露到宿主机的 MySQL 端口（仅 compose 使用，容器内始终为 3306）
# 本机 3306 已被其他 MySQL 占用时改成 3307
MYSQL_HOST_PORT=3306
# Docker Compose 专用：MySQL 容器初始化账号与密码
# 与上面的本机 DATABASE_URL 相互独立；正式部署前必须替换为强密码
MYSQL_USER=setp
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# Docker 构建时 better-sqlite3 源码编译所需 Node 头文件源；国内网络可改为镜像
# NODE_DIST_URL=https://npmmirror.com/mirrors/node

# -------------------- 跨域与反向代理 --------------------
# 允许的前端来源，多个用英文逗号分隔；生产环境必须显式配置
CORS_ORIGINS=http://localhost:5173
# Express trust proxy：false / true / 跳数 / 子网；放在 Nginx 后填 1
TRUST_PROXY=false

# -------------------- 默认账号（模板默认值，正式项目必须替换） --------------------
# NODE_ENV=production 时，以下三项仍为模板默认值会直接启动失败
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
SUPER_ADMIN_PASSWORD=superAdmin123456@
ADMIN_RESET_PASSWORD=123456

# -------------------- JWT 鉴权 --------------------
# 【生产环境必须修改】至少 32 位随机字符串；仍为 change-me-* 时启动失败
JWT_SECRET=change-me-in-production-0123456789abcdef
# Access Token 有效期（短，建议 15m）
JWT_EXPIRES_IN=15m
# Refresh Token 有效期（长，建议 7d）
JWT_REFRESH_EXPIRES_IN=7d

# -------------------- 安全配置 --------------------
# 登录失败锁定：连续失败 N 次锁定（分钟）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# -------------------- 配置中心敏感项加密 --------------------
# 生产环境必须配置：32 位以上随机字符串，用于 SMTP 授权码等敏感值的 AES-256-GCM 加密
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET_KEY=change-me-in-production-0123456789abcdef

# -------------------- 文件上传 --------------------
UPLOAD_DIR=./uploads
# 上传大小上限统一由配置中心 upload_max_size_mb 控制（默认 10MB）

# -------------------- 限流配置 --------------------
# 全局基础限流：每 IP 每窗口最大请求数 / 窗口分钟
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MIN=15
# 当前为内存 store，仅适合单实例；多实例部署需在部署层替换为 Redis 等共享 store
# 登录等敏感接口更严格：每 IP 每窗口最大请求数 / 窗口分钟
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=1

# -------------------- 日志配置 --------------------
# 是否打印控制台：true=控制台+文件，false=仅写文件 logs/app.log
LOG_CONSOLE=true
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=7

# -------------------- 数据备份 --------------------
# 备份保留份数
BACKUP_KEEP=7

# -------------------- 帮助中心（AI） --------------------
# Ollama 服务地址与模型；不可达/超时时 AI 对话自动降级为检索摘要
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=60
HELP_DATA_DIR=./data/help

# -------------------- 邮件服务（仅 seed 初始化一次） --------------------
# 运行期参数在「超级设置 → 邮件服务」维护；这里只给首次 seed 写库用。
MAIL_INIT_USER=YOUR MAIL ADDRESS
MAIL_INIT_PASS=YOUR MAIL AUTHORIZATION CODE
MAIL_INIT_FROM=YOUR MAIL ADDRESS
