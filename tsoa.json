{
  "entryFile": "app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/modules/**/*.controller.ts"],
  "spec": {
    "outputDirectory": "src/swagger",
    "specVersion": 3,
    "info": {
      "title": "setp-backend",
      "version": "0.8.7",
      "description": "Setp - Express + TypeScript + Prisma Backend Template"
    },
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "src/routes",
    "generatedRouteFilename": "routes",
    "middleware": "express",
    "authenticationModule": "src/middleware/auth.middleware.ts"
  }
}
